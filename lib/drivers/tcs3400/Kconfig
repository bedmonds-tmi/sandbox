config TMI_DRIVER_TCS3400
	bool "Enable tcs3400 pressure sense"
	default n
	select I2C
	select FPU
	select SENSOR
	help
		Enables the xgzp6897d pressure sense I2C, FPU and PRESSURE_API

config TMI_DRIVER_TCS3400_INIT_PRIORITY
	int "TCS3400	init priority"
	default 90
	depends on TMI_DRIVER_TCS3400
	help
		TCS3400 initialization priority.

if TMI_DRIVER_TCS3400

choice TMI_DRIVER_TCS3400_TRIGGER_MODE
	prompt "Trigger mode"
	default TMI_DRIVER_TCS3400_TRIGGER_NONE
	help
	  Specify the type of triggering used by the driver.

config TMI_DRIVER_TCS3400_TRIGGER_NONE
	bool "No trigger"

config TMI_DRIVER_TCS3400_TRIGGER_GLOBAL_THREAD
	bool "Use global thread"
	depends on GPIO
	select TMI_DRIVER_TCS3400_TRIGGER

config TMI_DRIVER_TCS3400_TRIGGER_OWN_THREAD
	bool "Use own thread"
	depends on GPIO
	select TMI_DRIVER_TCS3400_TRIGGER

endchoice

config TMI_DRIVER_TCS3400_TRIGGER
	bool

config TMI_DRIVER_TCS3400_THREAD_PRIORITY
	int "Thread priority"
	depends on TMI_DRIVER_TCS3400_TRIGGER_OWN_THREAD
	default 10
	help
	  Priority of thread used by the driver to handle interrupts.

config TMI_DRIVER_TCS3400_THREAD_STACK_SIZE
	int "Thread stack size"
	depends on TMI_DRIVER_TCS3400_TRIGGER_OWN_THREAD
	default 1024
	help
	  Stack size of thread used by the driver to handle interrupts.

endif # TMI_DRIVER_TCS3400