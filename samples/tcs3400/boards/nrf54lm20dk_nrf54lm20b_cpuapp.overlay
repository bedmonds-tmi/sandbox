#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/*
 * Two SoC constraints drive every pin choice below.
 *
 * PWM20/21/22 are the only PWM instances that share a power domain with a
 * GPIO port, and that domain covers P1 and P3 only -- a PWM output routed to
 * P0 or P2 simply never appears on the pin. The white LED therefore has to
 * be driven from P1 or P3.
 *
 * i2c20 and uart20 share one address, and uart20 is the DK's console, so
 * i2c21 is the lowest TWIM instance actually free to use.
 *
 * Everything else is kept on P1 so the whole sample lands on one bank of the
 * DK's GPIO header.
 *
 * P0.00/P0.01 are the DK's LFXO crystal pins and are not general-purpose
 * I/O; nothing here uses them.
 *
 *   SDA   P1.12      SCL   P1.13
 *   INT   P1.10      LED   P1.11
 */

&pinctrl {
	i2c21_tcs3400_default: i2c21_tcs3400_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 12)>,
				<NRF_PSEL(TWIM_SCL, 1, 13)>;
			bias-pull-up;
		};
	};

	i2c21_tcs3400_sleep: i2c21_tcs3400_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 12)>,
				<NRF_PSEL(TWIM_SCL, 1, 13)>;
			low-power-enable;
		};
	};

	pwm21_tcs3400_default: pwm21_tcs3400_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 11)>;
		};
	};

	pwm21_tcs3400_sleep: pwm21_tcs3400_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 11)>;
			low-power-enable;
		};
	};
};

&i2c21 {
	status = "okay";
	pinctrl-0 = <&i2c21_tcs3400_default>;
	pinctrl-1 = <&i2c21_tcs3400_sleep>;
	pinctrl-names = "default", "sleep";

	/*
	 * The INT output is open-drain and active-low, so it needs a pull-up.
	 * The internal one is requested here rather than fitting an external
	 * resistor, since this is the only device on the line.
	 *
	 * 4x gain over 64 integration cycles (178 ms) is a starting point for
	 * a close-range target under the white LED, not a calibrated setting.
	 * The sample retunes both at runtime through SENSOR_ATTR_GAIN and
	 * SENSOR_ATTR_OVERSAMPLING; the driver logs a warning when the
	 * channels saturate.
	 */
	color_sensor: tcs3400@39 {
		compatible = "tmi,tcs3400";
		status = "okay";
		reg = <0x39>;
		int-gpios = <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		gain-x = <4>;
		integration-cycles = <64>;
	};
};

&pwm21 {
	status = "okay";
	pinctrl-0 = <&pwm21_tcs3400_default>;
	pinctrl-1 = <&pwm21_tcs3400_sleep>;
	pinctrl-names = "default", "sleep";
};

/ {
	/*
	 * The LED driver takes a single PWM input that acts as both its enable
	 * and its brightness control, so there is no separate enable GPIO -- a
	 * 0% duty cycle is off.
	 *
	 * Merges into the board's existing pwmleds node. A 1 ms period puts
	 * ~178 full PWM cycles inside the shortest integration window the
	 * sensor is configured for, so brightness is averaged out rather than
	 * beating against the conversion.
	 */
	pwmleds {
		compatible = "pwm-leds";

		white_pwm_led: white_pwm_led {
			pwms = <&pwm21 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "White illumination LED";
		};
	};

	aliases {
		color-sensor = &color_sensor;
		white-led-pwm = &white_pwm_led;
	};
};
