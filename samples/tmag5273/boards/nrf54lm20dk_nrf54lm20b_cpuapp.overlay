#inclued <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>


&pinctrl {
    i2c22_default: i2c22_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 1, 13)>,
                <NRF_PSEL(TWIM_SDA, 1, 12)>;
        };
    };
        i2c22_sleep: i2c22_sleep {
        group2 {
            psels = <NRF_PSEL(TWIM_SCL, 1, 13)>,
                <NRF_PSEL(TWIM_SDA, 1, 12)>;
            low-power-enable;
        };
    };
};

&i2c22 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;

    tmag5273: tmag5273@22 {
        compatible = "ti,tmag5273";
        reg = <0x22>;
        status = "okay";

        /* Configure operating mode:
         * 0 = Standby, 1 = Sleep, 2 = Continuous measure
         */
        ti,operating-mode = <2>;

        /* Averaging: 0 = 1x, 1 = 2x, 2 = 4x, 3 = 8x, etc. */
        ti,average = <1>;

        /* Enable magnetic channels: X, Y, Z enabled */
        ti,channel-mode = <7>;
    };
};
