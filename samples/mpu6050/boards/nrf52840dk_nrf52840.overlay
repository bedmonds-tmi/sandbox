&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	imu: mpu6050@68 {
		compatible = "tmi,mpu6050";
		reg = <0x68>;
		label = "imu";
		status = "okay";
		gyro-fs-dps = <250>;
		accel-fs-mg = <2000>;
		/* MPU6050 INT pin wired to P0.02. Demonstrates the
		 * interrupt-driven data-ready trigger; boards without an
		 * int-gpios property fall back to polling in the app.
		 */
		int-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
	};
};
