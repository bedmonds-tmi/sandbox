&pinctrl {
	i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 12)>,
				<NRF_PSEL(TWIM_SCL, 1, 13)>;
		};
	};

	i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 12)>,
				<NRF_PSEL(TWIM_SCL, 1, 13)>;
			low-power-enable;
		};
	};
};

&i2c21 {
	status = "okay";
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";

	/* No int-gpios: this board demonstrates the app's polling fallback
	 * when no interrupt pin is wired up for imu.
	 */
	imu: mpu6050@68 {
		compatible = "tmi,mpu6050";
		reg = <0x68>;
		label = "imu";
		status = "okay";
		gyro-fs-dps = <250>;
		accel-fs-mg = <2000>;
	};
};
